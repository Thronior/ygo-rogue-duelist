{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadow-run-rooms",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomRegistry"
      },
      {
        "name": "RELAY",
        "class_name": "GameRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomRegistry"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "GameRelay"
      ]
    }
  ]
}
