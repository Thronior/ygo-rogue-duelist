{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadow-run-rooms",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  // "block" refuses online play (426) from clients that predate the /v2 multiplayer paths.
  // Blocked since v0.2.3 (the first /v2 release) was published on 2026-10-26.
  "vars": {
    "LEGACY_MULTIPLAYER": "block",
    // "block" refuses unencrypted cloud backups (426) from clients before the encrypted cloud save code.
    "LEGACY_BACKUPS": "block",
    // Daily ceiling on Worker requests (meter.mjs). Past it, online calls get 503 until 00:00 UTC, so a flood on Workers
    // Paid cannot run up the bill. 0 or missing turns it off.
    "DAILY_REQUEST_CAP": "1000000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomRegistry"
      },
      {
        "name": "RELAY",
        "class_name": "GameRelay"
      },
      {
        "name": "COLLECTOR",
        "class_name": "CollectorRegistry"
      },
      {
        "name": "PROGRESS",
        "class_name": "ProgressRegistry"
      },
      {
        "name": "DRAFT",
        "class_name": "DraftRegistry"
      },
      {
        "name": "BACKUP",
        "class_name": "BackupRegistry"
      },
      {
        "name": "TAG_HUB",
        "class_name": "TagHub"
      },
      {
        "name": "MATCH_HUB",
        "class_name": "MatchHub"
      },
      {
        "name": "METER",
        "class_name": "RequestMeter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomRegistry"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "GameRelay"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "CollectorRegistry"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "ProgressRegistry"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "DraftRegistry"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "BackupRegistry"
      ]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": [
        "TagHub",
        "MatchHub"
      ]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": [
        "RequestMeter"
      ]
    }
  ]
}
